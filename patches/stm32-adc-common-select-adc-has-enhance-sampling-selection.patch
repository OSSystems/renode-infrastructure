+++ b/src/Emulator/Peripherals/Peripherals/Analog/STM32C0_ADC.cs
@@ @@ public STM32C0_ADC(IMachine machine, double referenceVoltage, uint externalEvent
                 hasVbatPin: false,
                 hasChannelSelect: true,
                 hasChannelSequence: true,
